# Application
APP_ENV=development
ADDR=:8080
PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
STATIC_DIR=../frontend/dist
SECURE_COOKIES=false
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=change-this-key-in-production

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=documentation_center_go
DB_USER=root
DB_PASSWORD=admin
# Opcional: DSN completo (sobrepõe as variáveis acima)
# DB_DSN=root:admin@tcp(127.0.0.1:3306)/documentation_center_go?parseTime=true&loc=UTC

# Uploads
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=20

# Backups (banco + uploads locais)
BACKUP_DIR=./data/backups
BACKUP_RETENTION=7
BACKUP_AUTO=true
BACKUP_HOUR=3
# Opcional: caminhos dos binários do MySQL (detectados no PATH por padrão)
# MYSQLDUMP_BIN=mysqldump
# MYSQL_BIN=mysql

# Session (hours)
SESSION_TTL_HOURS=168

# Initial administrator (idempotent seed)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password
SEED_DEMO_DATA=true

# Optional e-mail notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@documentation.local
