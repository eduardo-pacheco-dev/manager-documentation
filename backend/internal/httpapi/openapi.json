{
  "openapi": "3.1.0",
  "info": {
    "title": "Documentation Center API",
    "version": "1.0.0",
    "description": "API do Documentation Center (Go + React + IBM Carbon). Autentique com sessão de navegador ou token Bearer."
  },
  "servers": [{ "url": "/api/v1" }],
  "tags": [
    { "name": "Auth", "description": "Cadastro, login e sessão" },
    { "name": "Users", "description": "Gestão de usuários (admin)" },
    { "name": "Dev docs", "description": "Wiki de desenvolvimento (admin)" },
    { "name": "Dashboard", "description": "Widgets do painel" },
    { "name": "Settings", "description": "Preferências e configurações" },
    { "name": "Notifications", "description": "Central de notificações" },
    { "name": "Projetos", "description": "Portfólio, EAP, dependências, recursos, custos e linha de base" },
    { "name": "Uploads", "description": "Envio de imagens" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "surname": { "type": ["string", "null"] },
          "full_name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "is_admin": { "type": "boolean" },
          "is_active": { "type": "boolean" },
          "theme": { "type": "string", "enum": ["system", "light", "dark"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "DevDoc": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": ["string", "null"] },
          "content": { "type": "string" },
          "is_published": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "level": { "type": "string", "enum": ["info", "success", "warning", "danger"] },
          "read_at": { "type": ["string", "null"], "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cria uma conta",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "password_confirmation"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "password_confirmation": { "type": "string" },
                  "device_name": { "type": "string", "description": "Quando informado, retorna um token Bearer." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Conta criada" },
          "422": { "description": "Validação", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Autentica e cria sessão",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "device_name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Autenticado" },
          "401": { "description": "Credenciais inválidas" },
          "429": { "description": "Muitas tentativas" }
        }
      }
    },
    "/auth/logout": {
      "post": { "tags": ["Auth"], "summary": "Encerra a sessão ou revoga o token atual", "responses": { "200": { "description": "Sessão encerrada" } } }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Retorna o usuário autenticado",
        "responses": { "200": { "description": "Usuário atual" }, "401": { "description": "Não autenticado" } }
      }
    },
    "/profile": {
      "get": { "tags": ["Settings"], "summary": "Perfil do usuário", "responses": { "200": { "description": "Perfil" } } },
      "put": { "tags": ["Settings"], "summary": "Atualiza nome e e-mail", "responses": { "200": { "description": "Perfil atualizado" }, "422": { "description": "Validação" } } }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Lista usuários com busca, filtros e paginação",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "profile", "in": "query", "schema": { "type": "string", "enum": ["admin", "user"] } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "inactive"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["name", "email", "is_admin", "created_at"] } },
          { "name": "direction", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "enum": [10, 25, 50] } }
        ],
        "responses": { "200": { "description": "Lista paginada" }, "403": { "description": "Acesso restrito" } }
      },
      "post": { "tags": ["Users"], "summary": "Cria usuário (admin)", "responses": { "201": { "description": "Usuário criado" }, "422": { "description": "Validação" } } }
    },
    "/users/{id}": {
      "put": { "tags": ["Users"], "summary": "Atualiza usuário (admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Atualizado" } } },
      "delete": { "tags": ["Users"], "summary": "Exclui usuário (admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Excluído" } } }
    },
    "/users/{id}/toggle": {
      "patch": { "tags": ["Users"], "summary": "Ativa ou desativa usuário (admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Status alterado" } } }
    },
    "/dev-docs": {
      "get": {
        "tags": ["Dev docs"],
        "summary": "Lista documentos da wiki",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Lista paginada com navegação" } }
      },
      "post": { "tags": ["Dev docs"], "summary": "Cria documento", "responses": { "201": { "description": "Criado" }, "422": { "description": "Validação" } } }
    },
    "/dev-docs/{id}": {
      "get": { "tags": ["Dev docs"], "summary": "Retorna documento com Markdown renderizado", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Documento" }, "404": { "description": "Não encontrado" } } },
      "put": { "tags": ["Dev docs"], "summary": "Atualiza documento", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Atualizado" } } },
      "delete": { "tags": ["Dev docs"], "summary": "Exclui documento", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Excluído" } } }
    },
    "/dashboard": {
      "get": { "tags": ["Dashboard"], "summary": "Widgets disponíveis, ordem, larguras e ocultos", "responses": { "200": { "description": "Dashboard" } } }
    },
    "/dashboard/widgets/order": {
      "put": { "tags": ["Dashboard"], "summary": "Salva a ordem dos widgets", "responses": { "200": { "description": "Ordem salva" } } }
    },
    "/dashboard/widgets/{id}": {
      "put": { "tags": ["Dashboard"], "summary": "Oculta ou mostra um widget", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Widget atualizado" } } }
    },
    "/dashboard/widgets/{id}/layout": {
      "put": { "tags": ["Dashboard"], "summary": "Redimensiona um widget (1 a 3 colunas)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Largura salva" } } }
    },
    "/work-context": {
      "get": {
        "tags": ["Integrações"],
        "summary": "Trabalho relacionado a uma estação ou site Nokia",
        "parameters": [
          { "name": "resource_type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["station", "nokia_site"] } },
          { "name": "resource_id", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Tarefas, follow-ups, eventos e vínculo cruzado" }, "404": { "description": "Recurso não encontrado" } }
      }
    },
    "/work-links": {
      "post": { "tags": ["Integrações"], "summary": "Vincula uma tarefa, follow-up ou evento a uma estação/site Nokia", "responses": { "201": { "description": "Vínculo criado" }, "404": { "description": "Item ou recurso não encontrado" } } }
    },
    "/work-links/{id}": {
      "delete": { "tags": ["Integrações"], "summary": "Remove um vínculo", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Vínculo removido" } } }
    },
    "/work-items": {
      "post": { "tags": ["Integrações"], "summary": "Cria e vincula tarefa, follow-up ou evento em uma única chamada", "responses": { "201": { "description": "Item criado e vinculado" }, "422": { "description": "Validação" } } }
    },
    "/links": {
      "get": {
        "tags": ["Links curtos"],
        "summary": "Lista links curtos com estatísticas",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "inactive", "expired"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Links e estatísticas" } }
      },
      "post": { "tags": ["Links curtos"], "summary": "Cria um link curto", "responses": { "201": { "description": "Link criado" }, "422": { "description": "Validação" } } }
    },
    "/links/export": {
      "get": { "tags": ["Links curtos"], "summary": "Exporta os links em CSV", "responses": { "200": { "description": "Arquivo CSV" } } }
    },
    "/links/{id}": {
      "get": { "tags": ["Links curtos"], "summary": "Detalhes, acessos, origens e série diária", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Detalhes do link" }, "404": { "description": "Não encontrado" } } },
      "put": { "tags": ["Links curtos"], "summary": "Atualiza um link curto", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Link atualizado" }, "422": { "description": "Validação" } } },
      "delete": { "tags": ["Links curtos"], "summary": "Exclui um link curto", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Link excluído" } } }
    },
    "/links/{id}/toggle": {
      "patch": { "tags": ["Links curtos"], "summary": "Ativa ou desativa um link curto", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Link atualizado" } } }
    },
    "/links/{id}/qr": {
      "get": { "tags": ["Links curtos"], "summary": "Gera o QR Code PNG do link curto", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Imagem PNG" } } }
    },
    "/links/{id}/files": {
      "get": { "tags": ["Links curtos"], "summary": "Lista os arquivos anexados ao link", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Arquivos" } } },
      "post": { "tags": ["Links curtos"], "summary": "Anexa arquivos ao link (multipart, 50 MB cada)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Arquivos anexados" }, "422": { "description": "Validação" } } }
    },
    "/links/{id}/files/{fileId}": {
      "delete": { "tags": ["Links curtos"], "summary": "Remove um arquivo do link", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "fileId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Arquivo removido" } } }
    },
    "/demands": {
      "get": {
        "tags": ["Demandas"],
        "summary": "Lista demandas com estatísticas e colaboradores",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "priority", "in": "query", "schema": { "type": "string" } },
          { "name": "assignee_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "scope", "in": "query", "schema": { "type": "string", "enum": ["mine", "created"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Demandas" } }
      },
      "post": { "tags": ["Demandas"], "summary": "Cria e encaminha uma demanda", "responses": { "201": { "description": "Demanda criada" }, "422": { "description": "Validação" } } }
    },
    "/demands/export": {
      "get": { "tags": ["Demandas"], "summary": "Exporta demandas em CSV", "responses": { "200": { "description": "Arquivo CSV" } } }
    },
    "/demands/collaborators": {
      "get": { "tags": ["Demandas"], "summary": "Lista colaboradores ativos", "responses": { "200": { "description": "Colaboradores" } } }
    },
    "/demands/{id}": {
      "get": { "tags": ["Demandas"], "summary": "Detalhes, histórico e anexos da demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Demanda" }, "404": { "description": "Não encontrada" } } },
      "put": { "tags": ["Demandas"], "summary": "Atualiza uma demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Demanda atualizada" }, "422": { "description": "Validação" } } },
      "delete": { "tags": ["Demandas"], "summary": "Exclui uma demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Demanda excluída" } } }
    },
    "/demands/{id}/status": {
      "patch": { "tags": ["Demandas"], "summary": "Altera o status da demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Status atualizado" } } }
    },
    "/demands/{id}/updates": {
      "post": { "tags": ["Demandas"], "summary": "Adiciona comentário ao histórico", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Comentário criado" } } }
    },
    "/demands/{id}/attachments": {
      "post": { "tags": ["Demandas"], "summary": "Anexa arquivos à demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Arquivos anexados" }, "422": { "description": "Validação" } } }
    },
    "/demands/{id}/attachments/{attachmentId}": {
      "get": { "tags": ["Demandas"], "summary": "Baixa um anexo da demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "attachmentId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Arquivo" } } },
      "delete": { "tags": ["Demandas"], "summary": "Remove um anexo da demanda", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "attachmentId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Anexo removido" } } }
    },
    "/projects": {
      "get": { "tags": ["Projetos"], "summary": "Lista o portfólio de projetos", "parameters": [{ "name": "archived", "in": "query", "schema": { "type": "string", "enum": ["0", "1"] } }], "responses": { "200": { "description": "Projetos" } } },
      "post": { "tags": ["Projetos"], "summary": "Cria um projeto", "responses": { "201": { "description": "Projeto criado" }, "422": { "description": "Validação" } } }
    },
    "/projects/{id}": {
      "get": { "tags": ["Projetos"], "summary": "Retorna o projeto com cronograma calculado, recursos, custos e linha de base", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Projeto completo" }, "404": { "description": "Não encontrado" } } },
      "put": { "tags": ["Projetos"], "summary": "Atualiza os dados do projeto", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Projeto atualizado" }, "422": { "description": "Validação" } } },
      "delete": { "tags": ["Projetos"], "summary": "Exclui o projeto e seus dados", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Projeto excluído" } } }
    },
    "/projects/{id}/archive": {
      "patch": { "tags": ["Projetos"], "summary": "Arquiva ou restaura o projeto", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Projeto atualizado" } } }
    },
    "/projects/{id}/export": {
      "get": { "tags": ["Projetos"], "summary": "Exporta a EAP e o cronograma em CSV", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Arquivo CSV" } } }
    },
    "/projects/{id}/tasks": {
      "post": { "tags": ["Projetos"], "summary": "Cria uma tarefa, resumo ou marco da EAP", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Tarefa criada" }, "422": { "description": "Validação" } } }
    },
    "/projects/{id}/tasks/{taskId}": {
      "put": { "tags": ["Projetos"], "summary": "Atualiza uma tarefa da EAP", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Tarefa atualizada" }, "422": { "description": "Validação" } } },
      "delete": { "tags": ["Projetos"], "summary": "Exclui uma tarefa da EAP", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Tarefa excluída" } } }
    },
    "/projects/{id}/tasks/{taskId}/move": {
      "patch": { "tags": ["Projetos"], "summary": "Move a tarefa para cima ou para baixo", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "taskId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Tarefa movida" } } }
    },
    "/projects/{id}/dependencies": {
      "post": { "tags": ["Projetos"], "summary": "Cria dependência FS, SS, FF ou SF com lag", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Dependência criada" }, "422": { "description": "Validação ou ciclo" } } }
    },
    "/projects/{id}/dependencies/{dependencyId}": {
      "delete": { "tags": ["Projetos"], "summary": "Remove uma dependência", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "dependencyId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Dependência removida" } } }
    },
    "/projects/{id}/resources": {
      "post": { "tags": ["Projetos"], "summary": "Cadastra um recurso com custo/hora e capacidade", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "201": { "description": "Recurso criado" }, "422": { "description": "Validação" } } }
    },
    "/projects/{id}/resources/{resourceId}": {
      "put": { "tags": ["Projetos"], "summary": "Atualiza um recurso", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "resourceId", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Recurso atualizado" } } },
